# remove from airootfs!
# This hook runs only while building the Archiso image.
# Password for the disposable, non-sudo live user "sinister" is "sinister".
[Trigger]
Operation = Install
Type = Package
Target = base

[Action]
Description = Creating SinisterNux disposable KDE live account...
When = PostTransaction
Depends = shadow
Exec = /usr/bin/useradd -u 1000 -m -s /usr/bin/bash -p $6$snx002live$SCfNDyaoapnlG0Lk8QhzIHnDaMOUrdGt4bsUnXMdXkS3847QWz7SMnMhGBOvScaQZNDbj08dL4Rwj/7eGJ5Wd1 sinister
